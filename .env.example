# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=sostituisci-con-una-chiave-lunga-e-casuale
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Lasciare false in locale. Su PythonAnywhere usare "Force HTTPS"
# nel pannello Web; cookie sicuri e HSTS si attivano automaticamente.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0

# Database: mysql oppure sqlite
DATABASE_ENGINE=mysql
DATABASE_NAME=gestionale
DATABASE_USER=luigi
DATABASE_PASSWORD=sostituisci-con-la-password-mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
